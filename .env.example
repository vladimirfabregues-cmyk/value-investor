# PostgreSQL connection string (the schema is PostgreSQL; Neon works).
DATABASE_URL=postgresql://user:password@localhost:5432/value_investor

# "mock" uses bundled fixtures (AAPL, MSFT, BRK.B, INTC only). This is the default.
# "yahoo" fetches live data for any ticker via Yahoo Finance (no API key required).
FINANCE_PROVIDER=yahoo

# Only for the GitHub Actions jobs (weekly refresh and monthly report). Store them as
# repository secrets, not in a local .env. SCREEN_INDICES is an optional comma-separated subset.
# SCREEN_RUN_URL=https://your-app.example/api/screen/run
# SCREEN_RUN_TOKEN=
# SCREEN_INDICES=
# RESEND_API_KEY=
# REPORT_EMAIL_TO=
