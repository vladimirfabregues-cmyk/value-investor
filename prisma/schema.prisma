generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for serverless runtime; direct connection for migrations.
  // Vercel's Neon integration provides both; falls back to DATABASE_URL locally.
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Analysis {
  id                String   @id @default(cuid())
  ticker            String
  /// Exchange code (see lib/finance/exchanges.ts). Together with `ticker` this
  /// forms the security identity — the same symbol on two markets is two
  /// distinct securities and must never collide.
  exchange          String   @default("US")
  companyName       String
  currency          String
  currentPrice      Float
  analysisDate      DateTime
  finalVerdictLabel String
  confidencePct     Float
  marginOfSafetyPct Float?
  oneLineVerdict    String
  fullJson          Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([exchange, ticker, createdAt])
  @@index([ticker, createdAt])
  @@index([createdAt])
}

model ScreenResult {
  id             String   @id @default(cuid())
  /// Unique per (ticker, screenerIndex): the same company may legitimately be a
  /// constituent of several indices (e.g. FTSE 250 ∩ MSCI Europe Small Cap)
  ticker         String
  companyName    String
  currency       String
  price          Float
  marketCap      Float?
  sector         String?
  verdictLabel   String
  compositeScore Float
  valuationScore Float
  healthScore    Float
  qualityScore   Float
  moatScore      Float
  marginOfSafety Float?
  pe             Float?
  pb             Float?
  ps             Float?
  evEbitda       Float?
  priceFcf       Float?
  grahamNumber   Float?
  screenerIndex  String   @default("SP500")
  screenerAt     DateTime
  /// Comma-separated red flags that capped the verdict (e.g. "peak_earnings,recent_ipo")
  verdictCaps    String?
  errorMessage   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([ticker, screenerIndex])
  @@index([verdictLabel])
  @@index([compositeScore])
  @@index([sector])
  @@index([screenerIndex])
}

/// Append-only, point-in-time record of every screening result. ScreenResult
/// holds only the latest state per ticker; this table preserves history so
/// verdicts can be backtested against subsequent price performance.
model ScreenSnapshot {
  id             String   @id @default(cuid())
  ticker         String
  screenerIndex  String
  screenerAt     DateTime
  verdictLabel   String
  compositeScore Float
  marginOfSafety Float?
  price          Float
  currency       String
  sector         String?
  verdictCaps    String?
  /// Point-in-time inputs a later review needs and that cannot be rebuilt
  /// afterwards (accounts get restated, the model changes). Null on rows
  /// written before they were captured.
  valuationScore  Float?
  healthScore     Float?
  qualityScore    Float?
  moatScore       Float?
  /// Modelled value per share (local currency) the margin of safety is taken against
  fairValue       Float?
  /// dcf | nav | ddm | pbroe
  valuationMethod String?
  marketCap       Float?
  modelVersion    String?
  /// Forward dividend yield (fraction), so relative returns can include dividends
  dividendYield   Float?
  createdAt      DateTime @default(now())

  @@index([screenerIndex, screenerAt])
  @@index([ticker, screenerAt])
  @@index([verdictLabel])
}

/// Cached daily price history for one ticker, so the weekly portfolio build
/// only re-downloads names still held (their split adjustments can change).
model PriceSeries {
  ticker    String   @id
  currency  String
  /// Requested window (ISO dates); `toDate` is the day it was fetched up to
  fromDate  String
  toDate    String
  /// [{ date, price }] closes, split-adjusted, in `currency`
  prices    Json
  /// [{ date, amountLocal }] cash dividends, split-adjusted
  dividends Json
  fetchedAt DateTime @default(now())
}

/// Latest computed state of a simulated "Strong Buy" portfolio — one row per
/// strategy (BUY_HOLD, REBALANCED, BENCHMARK). The result is fully regenerable
/// from ScreenSnapshot + market history, so it is stored as JSON snapshots
/// rather than normalised tables; the page just reads and renders it.
model SimPortfolio {
  id            String   @id @default(cuid())
  /// BUY_HOLD | REBALANCED | BENCHMARK
  strategy      String   @unique
  inceptionDate String
  capitalGbp    Float
  /// Value curve: [{ date, holdingsGbp, cashGbp, totalGbp }]
  valuations    Json
  /// Final open positions
  holdings      Json
  /// Transaction ledger
  transactions  Json
  /// Computed PortfolioMetrics
  metrics       Json
  /// When this build ran
  builtAt       DateTime
  updatedAt     DateTime @updatedAt
}

/// Latest rating scorecard (one row, id "latest"), rebuilt weekly from ScreenSnapshot.
model ScorecardResult {
  id      String   @id
  data    Json
  builtAt DateTime
}

/// Monthly report figures, frozen when the report is sent so later reports
/// can compare against them. `month` is "YYYY-MM".
model ReportArchive {
  month   String   @id
  data    Json
  builtAt DateTime
}

/// What became of a company that stopped being rated (delisted, taken over,
/// or still trading but no longer screened), so its ratings keep an outcome
/// instead of silently dropping out of the scorecard.
model TickerFate {
  ticker    String   @id
  /// TRADING | TAKEOVER | FAILURE
  status    String
  /// Last snapshot week the company was rated (ISO date)
  lastRated String
  /// Weekly closes after it stopped being rated (TRADING only), same units as snapshot prices
  closes    Json?
  checkedAt DateTime
}

/// Yahoo's split history for a company whose raw snapshot price jumped by a
/// split-like factor, so its earlier prices can be restated in today's shares.
model SplitCheck {
  ticker    String   @id
  /// [{ at, ratio }] — ratio = new shares per old share (1:4 reverse split → 0.25)
  splits    Json
  checkedAt DateTime
}
